{
  "expo": {
    "name": "Parso",
    "slug": "parso",
    "scheme": "parso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.parso.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "ai.parso.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFCC2A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Inter-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon-black.png",
          "imageWidth": 117,
          "resizeMode": "contain",
          "backgroundColor": "#F2F3F5"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "iosAppGroupIdentifier": "group.ai.parso.app",
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Parso checks your Screenshots album when you open it, so you can save new screenshots. Nothing is uploaded unless you tap Save.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Parso checks your Screenshots album when you open it, so you can save new screenshots. Nothing is uploaded unless you tap Save.",
          "savePhotosPermission": "Parso saves the photos you download to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withLocalNotificationsOnly",
      "expo-notifications",
      [
        "./plugins/withShareExtensionFixes",
        {
          "label": "Parso"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48c93477-c9d9-40dc-a823-69c42e6ecbf8"
      }
    },
    "owner": "pixanow"
  }
}
