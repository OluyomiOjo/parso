{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "preview-debug": {
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "buildConfiguration": "Debug"
      },
      "env": {
        "FORCE_BUNDLING": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6818469384"
      }
    }
  }
}
